<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_amoled">

    <TextView
        android:id="@+id/txtVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="56dp"
        android:text="● Encrypted Voice Call"
        android:textColor="@color/emerald_active"
        android:textSize="13sp"
        android:letterSpacing="0.05" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_circle_avatar_ring">

            <TextView
                android:id="@+id/txtVoiceAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1B172E"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/cyan_accent"
                android:textSize="48sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txtVoiceCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Alex Rivera"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVoiceTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="02:45"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Call Control Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_action"
            android:padding="16dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="Mute" />

        <ImageView
            android:id="@+id/btnEndVoiceCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_btn_danger"
            android:padding="20dp"
            android:src="@drawable/ic_call_end"
            android:contentDescription="End Call" />

        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_action"
            android:padding="16dp"
            android:src="@drawable/ic_speaker"
            android:contentDescription="Speaker" />

    </LinearLayout>

</RelativeLayout>
