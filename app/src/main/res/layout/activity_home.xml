<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_amoled">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerHome"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <RelativeLayout
            android:id="@+id/btnProfileHeader"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_avatar_ring">

            <TextView
                android:id="@+id/txtAvatarHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1F1C2E"
                android:gravity="center"
                android:text="N"
                android:textColor="@color/cyan_accent"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NovaChat"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online | Encrypted"
                android:textColor="@color/emerald_active"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_action"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_action"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Glass Tab Selector Bar -->
    <LinearLayout
        android:id="@+id/tabBarLayout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_below="@id/headerHome"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tabChats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary_gradient"
            android:gravity="center"
            android:text="Chats"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabGroups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Groups"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabCalls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Calls"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Contacts"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Main Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabBarLayout"
        android:orientation="vertical">

        <!-- Story / Status Bar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- Main Items RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/cyan_accent"
        app:tint="@color/amoled_black" />

</RelativeLayout>
